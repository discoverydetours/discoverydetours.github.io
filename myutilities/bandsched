<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Upcoming Events</title>
<style>
body { font-family: Arial, sans-serif; margin: 40px; }
h1 { margin-bottom: 10px; }
input { padding: 8px; width: 300px; margin-bottom: 20px; }
.event { padding: 10px 0; border-bottom: 1px solid #ddd; }
.date { font-weight: bold; }
.venue { color: #555; }
.band { color: #000; }
</style>
</head>
<body>

<h1>Events This Week</h1>
<input type="text" id="search" placeholder="Search by date, venue, or band...">

<div id="events"></div>

<script>
async function loadEvents() {
    const response = await fetch('events.json');
    const data = await response.json();

    const today = new Date();
    const nextWeek = new Date();
    nextWeek.setDate(today.getDate() + 7);

    const filtered = data
        .filter(e => {
            const eventDate = new Date(e.date);
            return eventDate >= today && eventDate <= nextWeek;
        })
        .sort((a, b) => new Date(a.date) - new Date(b.date));

    return filtered;
}

function render(events) {
    const container = document.getElementById('events');
    container.innerHTML = '';

    events.forEach(e => {
        const div = document.createElement('div');
        div.className = 'event';
        div.innerHTML = `
            <div class="date">${new Date(e.date).toDateString()}</div>
            <div class="venue">${e.venue}</div>
            <div class="band">${e.band_name}</div>
        `;
        container.appendChild(div);
    });
}

function applySearch(events) {
    const query = document.getElementById('search').value.toLowerCase();
    const filtered = events.filter(e =>
        e.venue.toLowerCase().includes(query) ||
        e.band_name.toLowerCase().includes(query) ||
        e.date.includes(query)
    );
    render(filtered);
}

let allEvents = [];

loadEvents().then(events => {
    allEvents = events;
    render(allEvents);

    document.getElementById('search')
        .addEventListener('input', () => applySearch(allEvents));
});
</script>

</body>
</html>
